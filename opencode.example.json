{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://app.ibra.ai.id/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "is/ibra": {
          "name": "Ibra X 3.1 Prime (Utama)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "is/ag/claude-sonnet-4-6": {
          "name": "Ibra X 3.1 Sonnet (Code & Vision)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "compatibility": {
            "cacheFormat": "anthropic"
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "is/ag/claude-opus-4-6-thinking": {
          "name": "Ibra X 3.1 Opus Thinking (Explorer)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "compatibility": {
            "cacheFormat": "anthropic",
            "reasoningField": "reasoning_content"
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "ag/gpt-oss-120b-medium": {
          "name": "Ibra X 3.1 Ultra Fast 120B",
          "limit": {
            "context": 128000,
            "output": 64000
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "9router/is/ibra",
  "formatter": true,
  "tool_output": {
    "max_lines": 3000,
    "max_bytes": 102400
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "background_compaction": true
  },
  "permissions": [
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "git push *--force*", "effect": "ask" }
  ],
  "agents": {
    "ibra-x": {
      "description": "Mesin Eksekusi Otonom Ibra X 3.1 (Otoritas Penuh & Eksekusi Cepat)",
      "mode": "all",
      "model": "9router/is/ag/claude-sonnet-4-6"
    },
    "explorer": {
      "description": "Subagent penjelajah kodebase yang cepat",
      "mode": "subagent",
      "model": "9router/is/ag/claude-opus-4-6-thinking"
    },
    "architect": {
      "description": "Perancang sistem, arsitektur software, dan spesifikasi API tingkat lanjut",
      "mode": "all",
      "model": "9router/is/ag/claude-sonnet-4-6"
    },
    "reviewer": {
      "description": "Auditor kode untuk keamanan, performa, dan potensi bug (read-only)",
      "mode": "subagent",
      "model": "9router/is/ag/claude-opus-4-6-thinking",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    }
  }
}
