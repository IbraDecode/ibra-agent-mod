set -e

VERSION="3.2.3"
INSTALL_DIR="/root/ibra-agent-mod"

print_banner() {
  echo -e "\033[1;36m┌────────────────────────────────────────────────────────┐\033[0m"
  echo -e "\033[1;36m│\033[0m   \033[1;37m🚀 IBRA X 3.1 — MESIN EKSEKUSI OTONOM CLI (v${VERSION})\033[0m    \033[1;36m│\033[0m"
  echo -e "\033[1;36m│\033[0m   \033[0;32mOtoritas Penuh · Tanpa Hambatan · Berorientasi Hasil\033[0m \033[1;36m│\033[0m"
  echo -e "\033[1;36m└────────────────────────────────────────────────────────┘\033[0m"
}

usage() {
  print_banner
  echo ""
  echo -e "\033[1;33mPenggunaan:\033[0m ibra <perintah> [argumen...]"
  echo ""
  echo -e "\033[1;32mPerintah Eksekusi Cerdas:\033[0m"
  echo "  run <tugas>         Jalankan tugas otonom dengan agen 'ibra-x' (Sonnet 4.6)"
  echo "  fast <tugas>        Eksekusi tugas kilat dengan model Ultra Fast 120B"
  echo "  explore <tugas>     Eksplorasi kode & audit logika mendalam (Opus Thinking)"
  echo "  sonnet <tugas>      Coding dan rekayasa arsitektur dengan Claude Sonnet 4.6"
  echo "  init <template>     Scaffold template proyek baru (api / worker / bot)"
  echo ""
  echo -e "\033[1;32mPerintah Analisis & Audit:\033[0m"
  echo "  status              Periksa metrik sistem, status Docker & koneksi router API"
  echo "  ping                Uji latensi round-trip (RTT) socket ke router AI"
  echo "  dns <host>          Resolusi DNS cepat untuk hostname/domain target"
  echo "  hash <file>         Hitung checksum SHA-256 dan MD5 integritas berkas"
  echo "  env                 Inspeksi variabel lingkungan & token (tersamar aman)"
  echo "  benchmark           Uji latensi respons real-time ke router AI"
  echo "  arsitektur          Analisis struktur modul, diagram Mermaid & refactoring"
  echo "  refactor            Audit kode dan rencana refactoring Clean Code & SOLID"
  echo "  dockerize           Generate Dockerfile multi-stage & compose produksi"
  echo "  keamanan            Audit celah keamanan OWASP, kebocoran secret & permissions"
  echo "  tinjau              Audit diff Git terkini sebelum commit"
  echo "  stats               Statistik total skills, commands, MCP, dan riwayat commit"
  echo ""
  echo -e "\033[1;32mPerintah Manajemen Sistem:\033[0m"
  echo "  doctor              Diagnostik integritas konfigurasi, MCP server & network"
  echo "  clean               Bersihkan cache python & berkas temporer lingkungan"
  echo "  backup              Buat arsip cadangan tarball konfigurasi & skills"
  echo "  notify <pesan>      Kirim notifikasi alert via Telegram, Discord, atau Webhook"
  echo "  update              Perbarui mod Ibra X 3.1 ke versi terbaru dari GitHub"
  echo "  mcp                 Tampilkan status server Model Context Protocol"
  echo "  version             Tampilkan informasi versi saat ini"
  echo ""
}

cmd_doctor() {
  print_banner
  echo -e "\n\033[1;34m=== DIAGNOSTIK KESEHATAN SISTEM IBRA X 3.1 ===\033[0m\n"
  
  # 1. Cek OpenCode
  if command -v opencode >/dev/null 2>&1; then
    echo -e "  [\033[32m✓\033[0m] OpenCode CLI terpasang: $(which opencode)"
  else
    echo -e "  [\033[31m✗\033[0m] OpenCode CLI tidak ditemukan!"
  fi

  # 2. Cek Python
  if command -v python3 >/dev/null 2>&1; then
    echo -e "  [\033[32m✓\033[0m] Python Runtime: $(python3 -V)"
  else
    echo -e "  [\033[31m✗\033[0m] Python 3 tidak ditemukan!"
  fi

  # 3. Cek Git & GitHub CLI
  if command -v git >/dev/null 2>&1; then
    echo -e "  [\033[32m✓\033[0m] Git Version: $(git --version)"
  fi
  if command -v gh >/dev/null 2>&1; then
    local gh_user
    gh_user=$(gh api user -q .login 2>/dev/null || echo "offline")
    echo -e "  [\033[32m✓\033[0m] GitHub CLI login sebagai: \033[1;32m@${gh_user}\033[0m"
  fi

  # 4. Cek MCP Server
  echo -e "\n\033[1;34mStatus MCP Server:\033[0m"
  opencode mcp list 2>&1 | sed 's/^/  /'

  # 5. Cek Koneksi Router API
  echo -e "\n\033[1;34mKoneksi Router API (https://app.ibra.ai.id/v1):\033[0m"
  local http_code
  http_code=$(curl -o /dev/null -s -w "%{http_code}" -H "Authorization: Bearer sk-74719b5a958826c8-wenh6o-7dd6518c" https://app.ibra.ai.id/v1/models || echo "000")
  if [ "$http_code" = "200" ]; then
    echo -e "  [\033[32m✓\033[0m] Router API Online (HTTP 200 OK)"
  else
    echo -e "  [\033[31m✗\033[0m] Router API mengembalikan kode HTTP: $http_code"
  fi
  echo ""
}

cmd_dns() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Masukkan nama host/domain. Contoh: ibra dns app.ibra.ai.id"
    exit 1
  fi
  python3 -c "
import socket, sys, time
host = sys.argv[1].replace('https://', '').replace('http://', '').split('/')[0].split(':')[0]
t0 = time.time()
try:
    res = socket.getaddrinfo(host, None)
    ips = sorted(list({r[4][0] for r in res}))
    elapsed = (time.time() - t0) * 1000
    print(f'🌐 Resolusi DNS untuk {host} ({elapsed:.1f}ms):')
    for ip in ips:
        print(f'  • {ip}')
except Exception as e:
    print(f'❌ Gagal: {e}')
" "$target"
}

cmd_hash() {
  local target="${1:-}"
  if [ -z "$target" ] || [ ! -f "$target" ]; then
    echo "Masukkan berkas yang valid. Contoh: ibra hash install.sh"
    exit 1
  fi
  python3 -c "
import hashlib, sys, os
fpath = sys.argv[1]
sha = hashlib.sha256()
md5 = hashlib.md5()
with open(fpath, 'rb') as f:
    for c in iter(lambda: f.read(65536), b''):
        sha.update(c)
        md5.update(c)
print(f'🔐 Checksum Berkas: {os.path.abspath(fpath)}')
print(f'• Ukuran  : {os.path.getsize(fpath)} bytes')
print(f'• SHA-256 : {sha.hexdigest()}')
print(f'• MD5     : {md5.hexdigest()}')
" "$target"
}

cmd_ping() {
  print_banner
  echo -e "\n\033[1;34m=== UJI LATENSI TCP SOCKET KE ROUTER AI ===\033[0m\n"
  python3 -c "
import socket, time
host = 'app.ibra.ai.id'
port = 443
rtts = []
print(f'Menguji latensi TCP ke {host}:{port}...')
for i in range(3):
    t0 = time.time()
    try:
        s = socket.create_connection((host, port), timeout=3.0)
        rtt = (time.time() - t0) * 1000
        rtts.append(rtt)
        s.close()
        print(f'  [Ping #{i+1}] Latensi: {rtt:.2f} ms')
    except Exception as e:
        print(f'  [Ping #{i+1}] Gagal: {e}')
    time.sleep(0.3)

if rtts:
    avg_rtt = sum(rtts) / len(rtts)
    print(f'\nStatistik Latensi: Min={min(rtts):.2f}ms | Avg={avg_rtt:.2f}ms | Max={max(rtts):.2f}ms')
"
}

cmd_env() {
  print_banner
  echo -e "\n\033[1;34m=== STATUS VARIABEL LINGKUNGAN AI & WEBHOOK ===\033[0m\n"
  python3 -c "
import os

def mask(val):
    if not val:
        return '❌ Tidak Diatur'
    if len(val) <= 8:
        return '✓ Diatur (***)'
    return f'✓ Diatur ({val[:4]}...{val[-4:]})'

keys = [
    ('OPENAI_API_KEY', os.getenv('OPENAI_API_KEY')),
    ('TELEGRAM_BOT_TOKEN', os.getenv('TELEGRAM_BOT_TOKEN')),
    ('TELEGRAM_CHAT_ID', os.getenv('TELEGRAM_CHAT_ID')),
    ('DISCORD_WEBHOOK_URL', os.getenv('DISCORD_WEBHOOK_URL')),
]

for name, val in keys:
    print(f'  • {name:<22}: {mask(val)}')
print(f'  • AI Router Endpoint    : https://app.ibra.ai.id/v1')
print(f'  • Provider ID Utama     : 9router')
"
  echo ""
}

cmd_stats() {
  print_banner
  echo -e "\n\033[1;34m=== STATISTIK EKOSISTEM IBRA X 3.1 ===\033[0m\n"
  local skills_count
  skills_count=$(ls -d "$INSTALL_DIR/skills"/*/ 2>/dev/null | wc -l || echo "0")
  local commands_count
  commands_count=$(ls -1 "$INSTALL_DIR/commands"/*.md 2>/dev/null | wc -l || echo "0")
  local git_commits
  git_commits=$(cd "$INSTALL_DIR" && git rev-list --count HEAD 2>/dev/null || echo "N/A")
  local latest_commit
  latest_commit=$(cd "$INSTALL_DIR" && git log -1 --format="%h (%cr) - %s" 2>/dev/null || echo "N/A")

  echo -e "  • \033[1;32mTotal Keahlian (Skills)\033[0m   : ${skills_count} skills terpasang"
  echo -e "  • \033[1;32mPerintah Pintar (Commands)\033[0m: ${commands_count} commands aktif"
  echo -e "  • \033[1;32mVersi Command Center\033[0m      : v${VERSION}"
  echo -e "  • \033[1;32mTotal Git Commits\033[0m         : ${git_commits} commits"
  echo -e "  • \033[1;32mCommit Terakhir\033[0m           : ${latest_commit}"
  echo -e "  • \033[1;32mServer MCP Terhubung\033[0m      : $(opencode mcp list 2>&1 | tr '\n' ' ')"
  echo ""
}

cmd_init() {
  local template="${1:-}"
  if [ -z "$template" ]; then
    echo -e "\033[1;33mPilih template proyek yang ingin dibuat:\033[0m"
    echo "  1) api     — REST API Server (Python FastAPI + Dockerfile)"
    echo "  2) worker  — Cloudflare Worker (TypeScript + wrangler.toml)"
    echo "  3) bot     — Webhook Automation Bot"
    read -p "Masukkan pilihan [api/worker/bot]: " template
  fi

  case "$template" in
    1|api)
      echo "→ Membuat scaffolding REST API Service..."
      cat <<'EOF' > main.py
from fastapi import FastAPI
import uvicorn, os

app = FastAPI(title="Ibra Microservice API", version="1.0.0")

@app.get("/")
def root():
    return {"status": "online", "engine": "Ibra X 3.1"}

@app.get("/healthz")
def health():
    return {"healthy": True}

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=int(os.getenv("PORT", 8000)))
EOF
      cat <<'EOF' > requirements.txt
fastapi>=0.110.0
uvicorn>=0.28.0
EOF
      cat <<'EOF' > Dockerfile
FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 8000
CMD ["python", "main.py"]
EOF
      echo -e "\033[1;32m✓ Proyek REST API berhasil dibuat di direktori saat ini!\033[0m"
      ;;
    2|worker)
      echo "→ Membuat scaffolding Cloudflare Worker..."
      cat <<'EOF' > wrangler.toml
name = "ibra-worker"
main = "src/index.ts"
compatibility_date = "2024-11-01"
EOF
      mkdir -p src
      cat <<'EOF' > src/index.ts
export default {
  async fetch(request: Request): Promise<Response> {
    return new Response(JSON.stringify({ status: "OK", edge: "Ibra Cloudflare Worker" }), {
      headers: { "Content-Type": "application/json" }
    });
  }
};
EOF
      echo -e "\033[1;32m✓ Proyek Cloudflare Worker berhasil dibuat di direktori saat ini!\033[0m"
      ;;
    3|bot)
      echo "→ Membuat scaffolding Webhook Automation Bot..."
      cat <<'EOF' > bot.py
import os, sys, urllib.request, json

TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")

def send_alert(message: str):
    if not TOKEN or not CHAT_ID:
        print("Set TELEGRAM_BOT_TOKEN dan TELEGRAM_CHAT_ID di environment!")
        return
    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    payload = json.dumps({"chat_id": CHAT_ID, "text": message, "parse_mode": "Markdown"}).encode()
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req) as resp:
        print("Alert terkirim:", resp.status)

if __name__ == "__main__":
    send_alert("🚀 *Ibra Bot*: Service operasional.")
EOF
      echo -e "\033[1;32m✓ Proyek Webhook Bot berhasil dibuat di direktori saat ini!\033[0m"
      ;;
    *)
      echo "Template tidak dikenal: $template"
      exit 1
      ;;
  esac
}

cmd_clean() {
  print_banner
  echo -e "\n\033[1;34m=== PEMBERSIHAN FILE SEMENTARA & CACHE ===\033[0m\n"
  local cleaned=0
  for p in /tmp/__pycache__* /tmp/*.tmp /tmp/antigravity; do
    if [ -e "$p" ]; then
      rm -rf "$p" 2>/dev/null && ((cleaned++)) || true
    fi
  done
  find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
  find . -type f -name "*.pyc" -delete 2>/dev/null || true
  echo -e "  [\033[32m✓\033[0m] Cache Python & berkas temporer berhasil dibersihkan."
  echo ""
}

cmd_backup() {
  print_banner
  echo -e "\n\033[1;34m=== MEMBUAT CADANGAN SISTEM IBRA X 3.1 ===\033[0m\n"
  local timestamp
  timestamp=$(date +"%Y%m%d_%H%M%S")
  local backup_file="/root/ibra_backup_${timestamp}.tar.gz"

  echo "Mengarsipkan konfigurasi OpenCode dan modul..."
  tar -czf "$backup_file" -C /root .config/opencode ibra-agent-mod 2>/dev/null || true

  if [ -f "$backup_file" ]; then
    local size
    size=$(du -h "$backup_file" | cut -f1)
    echo -e "  [\033[32m✓\033[0m] Backup berhasil dibuat: \033[1;32m$backup_file\033[0m ($size)"
  else
    echo -e "  [\033[31m✗\033[0m] Gagal membuat file backup."
  fi
  echo ""
}

cmd_update() {
  print_banner
  echo -e "\n\033[1;34m=== MEMPERBARUI IBRA X 3.1 DARI GITHUB ===\033[0m\n"
  if [ -d "$INSTALL_DIR/.git" ]; then
    cd "$INSTALL_DIR"
    git pull origin main
    bash install.sh opencode
    echo -e "\n\033[1;32m✓ Pembaruan Ibra X 3.1 selesai dan siap digunakan!\033[0m"
  else
    echo "Direktori repositori tidak ditemukan di $INSTALL_DIR"
    exit 1
  fi
}

interactive_menu() {
  print_banner
  echo -e "\n\033[1;33mPILIH TINDAKAN OPERASIONAL:\033[0m"
  echo "  [1] 🚀 Jalankan Tugas Otonom (ibra-x / Sonnet 4.6)"
  echo "  [2] ⚡ Tanya Kilat (Ultra Fast 120B)"
  echo "  [3] 🧠 Eksplorasi Kode & Audit Logika (Opus Thinking)"
  echo "  [4] 📊 Status Kesehatan Sistem & Router API"
  echo "  [5] ⏱️  Uji Benchmark Latensi AI Real-Time"
  echo "  [6] 🏗️  Analisis Arsitektur Codebase"
  echo "  [7] ♻️  Audit & Rekomendasi Refactoring (Clean Code)"
  echo "  [8] 🐳 Buat Konfigurasi Dockerfile Produksi (Dockerize)"
  echo "  [9] 🔒 Audit Keamanan OWASP & Secret Leaks"
  echo "  [10] 🩺 Diagnostik Lengkap (Doctor)"
  echo "  [11] 📢 Kirim Notifikasi Alert (ibra notify)"
  echo "  [12] 🔄 Perbarui Mod dari GitHub"
  echo "  [13] 📈 Statistik Sistem & Mod (ibra stats)"
  echo "  [14] 🧹 Bersihkan Cache & File Sementara (ibra clean)"
  echo "  [15] 💾 Buat Cadangan Konfigurasi & Skills (ibra backup)"
  echo "  [0] 🚪 Keluar"
  echo ""
  read -p "Masukkan nomor pilihan [0-15]: " choice
  case "$choice" in
    1)
      read -p "Masukkan tugas untuk ibra-x: " task
      [ -n "$task" ] && exec opencode run --agent ibra-x "$task"
      ;;
    2)
      read -p "Masukkan prompt kilat: " task
      [ -n "$task" ] && exec opencode run -m 9router/ag/gpt-oss-120b-medium "$task"
      ;;
    3)
      read -p "Masukkan target eksplorasi: " task
      [ -n "$task" ] && exec opencode run --agent explorer "$task"
      ;;
    4) exec opencode run "/status" ;;
    5) exec opencode run "/benchmark" ;;
    6) exec opencode run "/arsitektur" ;;
    7) exec opencode run "/refactor" ;;
    8) exec opencode run "/dockerize" ;;
    9) exec opencode run "/keamanan" ;;
    10) cmd_doctor ;;
    11)
      read -p "Pesan notifikasi: " msg
      [ -n "$msg" ] && exec /root/ibra-agent-mod/bin/ibra-notify "$msg"
      ;;
    12) cmd_update ;;
    13) cmd_stats ;;
    14) cmd_clean ;;
    15) cmd_backup ;;
    0|"") echo "Selesai."; exit 0 ;;
    *) echo "Pilihan tidak valid."; exit 1 ;;
  esac
}

# Routing Subcommand
case "${1:-}" in
  run)
    shift
    if [ $# -eq 0 ]; then
      echo "Silakan masukkan deskripsi tugas. Contoh: ibra run 'Refactor fungsi auth'"
      exit 1
    fi
    exec opencode run --agent ibra-x "$*"
    ;;
  fast)
    shift
    if [ $# -eq 0 ]; then
      echo "Silakan masukkan prompt. Contoh: ibra fast 'Jelaskan quicksort'"
      exit 1
    fi
    exec opencode run -m 9router/ag/gpt-oss-120b-medium "$*"
    ;;
  explore)
    shift
    if [ $# -eq 0 ]; then
      echo "Silakan masukkan target eksplorasi. Contoh: ibra explore 'Audit struktur database'"
      exit 1
    fi
    exec opencode run --agent explorer "$*"
    ;;
  sonnet)
    shift
    exec opencode run -m 9router/is/ag/claude-sonnet-4-6 "$*"
    ;;
  status)
    exec opencode run "/status"
    ;;
  ping)
    cmd_ping
    ;;
  env)
    cmd_env
    ;;
  dns)
    shift
    cmd_dns "$@"
    ;;
  hash)
    shift
    cmd_hash "$@"
    ;;
  benchmark)
    exec opencode run "/benchmark"
    ;;
  arsitektur)
    exec opencode run "/arsitektur"
    ;;
  refactor)
    exec opencode run "/refactor"
    ;;
  dockerize)
    exec opencode run "/dockerize"
    ;;
  keamanan)
    exec opencode run "/keamanan"
    ;;
  stats)
    cmd_stats
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  tinjau)
    exec opencode run "/tinjau"
    ;;
  doctor)
    cmd_doctor
    ;;
  clean)
    cmd_clean
    ;;
  backup)
    cmd_backup
    ;;
  update)
    cmd_update
    ;;
  mcp)
    exec opencode mcp list
    ;;
  notify)
    shift
    exec /root/ibra-agent-mod/bin/ibra-notify "$@"
    ;;
  version|-v|--version)
    echo "Ibra X 3.1 Command Center v${VERSION}"
    ;;
  menu)
    interactive_menu
    ;;
  help|-h|--help)
    usage
    ;;
  "")
    if [ -t 0 ]; then
      interactive_menu
    else
      usage
    fi
    ;;
  *)
    # Jika memasukkan teks langsung tanpa subcommand, arahkan langsung ke agen ibra-x
    exec opencode run --agent ibra-x "$*"
    ;;
esac
