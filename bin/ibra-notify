#!/usr/bin/env bash
# ==============================================================================
# IBRA NOTIFY — Universal Webhook & Alert Dispatcher
# Mendukung: Telegram Bot API & Discord Webhook
# Author: Ibra Ramdan <ibradecode@gmail.com>
# ==============================================================================
set -e

MSG="${1:-Pemberitahuan dari sistem Ibra X 3.1}"
TITLE="${2:-Ibra X 3.1 Notification}"

# 1. Kirim ke Telegram (jika variabel lingkungan tersedia)
if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
  TEXT="*${TITLE}*%0A${MSG}"
  curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d "chat_id=${TELEGRAM_CHAT_ID}" \
    -d "text=${TEXT}" \
    -d "parse_mode=Markdown" > /dev/null && echo "✓ Terkirim ke Telegram"
fi

# 2. Kirim ke Discord (jika variabel lingkungan tersedia)
if [ -n "${DISCORD_WEBHOOK_URL:-}" ]; then
  PAYLOAD=$(python3 -c "import json, sys; print(json.dumps({'content': f'**{sys.argv[1]}**\n{sys.argv[2]}'}))" "$TITLE" "$MSG")
  curl -s -H "Content-Type: application/json" -X POST -d "$PAYLOAD" "$DISCORD_WEBHOOK_URL" > /dev/null && echo "✓ Terkirim ke Discord"
fi

# 3. Output lokal jika tidak ada webhook yang diset
if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] && [ -z "${DISCORD_WEBHOOK_URL:-}" ]; then
  echo -e "\033[1;36m[NOTIFY]\033[0m \033[1;33m${TITLE}:\033[0m ${MSG}"
fi
